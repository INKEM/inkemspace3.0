---
import type { GetStaticPaths } from 'astro'
import NotesPage from '@/components/notes/NotesPage.astro'
import { getSortedNotesPaginated } from '@/utils/content'
import { notes } from '@/config.json'

export const getStaticPaths = (async () => {
  const { totalPages } = await getSortedNotesPaginated(1, notes.perPage)

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2
    return { params: { page: String(page) }, props: { page } }
  })
}) satisfies GetStaticPaths

const { page } = Astro.props
---

<NotesPage page={page} />
