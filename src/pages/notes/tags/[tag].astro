---
import type { GetStaticPaths } from 'astro'
import PageLayout from '@/layouts/PageLayout.astro'
import NotesList from '@/components/notes/NotesList.astro'
import { getAllNoteTags, getNotesByTag } from '@/utils/content'

export const getStaticPaths = (async () => {
  const allNoteTags = await getAllNoteTags()

  const paths = allNoteTags.map((tag) => {
    return {
      params: { tag: tag.slug },
      props: { tagName: tag.name },
    }
  })

  return paths
}) satisfies GetStaticPaths

interface Props {
  tagName: string
}

const { tag } = Astro.params
const { tagName } = Astro.props

if (!tag) {
  return Astro.redirect('/notes')
}

const notes = await getNotesByTag(tag)

if (notes.length === 0) {
  return Astro.redirect('/notes')
}
---

<PageLayout title={`杂记 · ${tagName}`}>
  <div class="max-w-[1008px] px-5 md:px-6 py-10 md:py-16 mx-auto">
    <div class="mb-10 md:mb-14">
      <a class="note-link mb-4" href="/notes">
        <i class="iconfont icon-arrow-left" aria-hidden="true"></i>
        <span>返回杂记</span>
      </a>
      <h1 class="text-3xl font-bold text-primary mb-2">标签：{tagName}</h1>
      <p class="text-secondary">共找到 {notes.length} 条杂记</p>
    </div>

    <NotesList notes={notes} />
  </div>
</PageLayout>
