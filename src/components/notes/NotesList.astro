---
import NoteCard from './NoteCard.astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  notes: CollectionEntry<'notes'>[]
}

const { notes } = Astro.props
const yearFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  timeZone: 'Asia/Shanghai',
})
const notesByYear = new Map<string, CollectionEntry<'notes'>[]>()

for (const note of notes) {
  const year = yearFormatter.format(note.data.date)
  const group = notesByYear.get(year)
  if (group) group.push(note)
  else notesByYear.set(year, [note])
}
---

<div class="space-y-9 md:space-y-14">
  {notes.length === 0 && <p class="text-secondary">暂无杂记</p>}
  {
    Array.from(notesByYear, ([year, entries]) => (
      <section class="grid md:grid-cols-[7rem_minmax(0,1fr)] md:gap-x-8">
        <h2 class="mb-3 text-2xl font-bold text-accent md:mb-0 md:pt-5 md:text-3xl">{year}</h2>
        <div class="divide-y divide-primary border-t border-primary">
          {entries.map((note) => (
            <NoteCard note={note} />
          ))}
        </div>
      </section>
    ))
  }
</div>
