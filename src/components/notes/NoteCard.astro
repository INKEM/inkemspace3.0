---
import { getNoteExcerpt, slugify } from '@/utils/content'
import type { CollectionEntry } from 'astro:content'

interface Props {
  note: CollectionEntry<'notes'>
  showExcerpt?: boolean
  showTags?: boolean
  showYear?: boolean
}

const { note, showExcerpt = true, showTags = true, showYear = false } = Astro.props
const { title, tags, date } = note.data
const excerpt = showExcerpt ? getNoteExcerpt(note) : ''
const formattedDate = date.toLocaleDateString('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: showYear ? 'numeric' : undefined,
  month: 'long',
  day: 'numeric',
})
---

<article
  class="grid gap-y-1.5 py-5 sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:items-baseline sm:gap-x-5 md:py-6"
>
  <time class="text-sm text-secondary tabular-nums" datetime={date.toISOString()}>
    {formattedDate}
  </time>
  <div class="min-w-0">
    <h3 class="text-xl font-bold leading-snug">
      <a class="note-link note-title-link" href={`/notes/${note.slug}`}>
        <span>{title}</span>
        <i class="iconfont icon-arrow-right" aria-hidden="true"></i>
      </a>
    </h3>
    {
      excerpt && (
        <p class="mt-2.5 max-w-[41rem] line-clamp-3 break-words leading-relaxed text-secondary">
          {excerpt}
        </p>
      )
    }
    {
      showTags && tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2 text-sm">
          {tags.map((tag) => (
            <li>
              <a class="note-tag" href={`/notes/tags/${slugify(tag)}`}>
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
