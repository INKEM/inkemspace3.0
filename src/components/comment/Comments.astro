---
interface Props {
  legacyPath?: string
}

const { legacyPath } = Astro.props
// Giscus uses the encoded browser pathname without the leading slash.
const legacyTerm = legacyPath && new URL(legacyPath, Astro.url).pathname.slice(1)
---

<div>
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="INKEM/inkemspace3.0"
    data-repo-id="R_kgDORphVmQ"
    data-category="Announcements"
    data-category-id="DIC_kwDORphVmc4C-ASQ"
    data-mapping={legacyTerm ? 'specific' : 'pathname'}
    data-term={legacyTerm}
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="preferred_color_scheme"
    data-lang="zh-CN"
    crossorigin="anonymous"
    async></script>
</div>
